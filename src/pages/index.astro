---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SeoHead from "../components/SeoHead.astro";
import { SITE, SITE_URL, type CategoryId, categoryName } from "../consts";
import { getPublishedPosts, selectFeatured } from "../lib/content";
import { routes } from "../lib/links";
import communityLogo from "../assets/techs-community-logo.png";
import "../styles/global.css";

const posts = await getPublishedPosts();
const authors = await getCollection("authors");
const authorsById = new Map(authors.map((author) => [author.id, author.data]));
const featured = selectFeatured(posts);
const recentPosts = posts.slice(0, 3);
const joinUrl =
  "https://github.com/techs-community/.github/issues/new?template=solicitar-acesso.yml";
const communityTopics = [
  ["Arquitetura de software", "Padrões, decisões, trade-offs e boas práticas"],
  ["Sistemas & infraestrutura", "Do baixo nível ao cloud"],
  ["Desenvolvimento", "Linguagens, frameworks e ferramentas"],
  ["Segurança", "Informações, alertas e discussões"],
  ["Vagas", "Oportunidades compartilhadas pela comunidade"],
  ["E o que mais rolar", "Conversa livre dentro do universo tech"],
] as const;
const pageTitle = `${SITE.title} — Tecnologia compartilhada em português`;
const canonicalUrl = new URL("/", SITE_URL).toString();
const socialImageUrl = new URL(communityLogo.src, SITE_URL).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: canonicalUrl,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE.org,
    logo: socialImageUrl,
  },
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(SITE.locale, {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: SITE.timeZone,
  })
    .format(date)
    .replace(" de ", " ")
    .replace(" de ", " ")
    .toUpperCase();
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e7e0d2" />
    <SeoHead
      title={pageTitle}
      description={SITE.description}
      canonical={canonicalUrl}
      image={socialImageUrl}
      imageAlt="Arte oficial da Techs Community com três pessoas de terno e computadores no lugar das cabeças."
      imageWidth={communityLogo.width}
      imageHeight={communityLogo.height}
      imageType="image/png"
      structuredData={structuredData}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Techs Community, início">
          <span class="wordmark-mark" aria-hidden="true">TC</span>
          <span>TECHS<br />COMMUNITY</span>
        </a>

        <nav aria-label="Navegação principal">
          <a href="#recentes">Artigos</a>
          <a href="#assuntos">Assuntos</a>
          <a href="#manifesto">Sobre</a>
          <a href="#participar">Participar</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span>TRANSMISSÃO ABERTA</span> // PT-BR</p>
          <h1 id="hero-title">
            Conhecimento<br />não deveria ter<br /><em>crachá.</em>
          </h1>
          <p class="hero-lead">
            Uma comunidade divertida e nerd para quem vive e respira tecnologia.
            A gente troca ideia, aprende junto e cresce sem formalidade — e com
            muito bom humor. 🤓
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#recentes"
              >Explorar artigos <span>↓</span></a
            >
            <a class="button button-ghost" href="#participar"
              >Como participar <span>↓</span></a
            >
          </div>
        </div>

        <aside class="signal-panel" aria-label="Estado do arquivo editorial">
          <div class="signal-head">
            <span>SISTEMA // ONLINE</span>
            <span class="live"><i></i> AO VIVO</span>
          </div>
          <div class="signal-visual">
            <Image
              src={communityLogo}
              alt="Arte oficial da Techs Community: três pessoas de terno com computadores e circuitos no lugar das cabeças."
              widths={[480, 720, 960]}
              sizes="(max-width: 800px) calc(100vw - 3rem), 40vw"
              format="webp"
              quality={86}
            />
          </div>
          <dl class="signal-stats">
            <div>
              <dt>REGISTROS</dt><dd>{String(posts.length).padStart(2, "0")}</dd>
            </div>
            <div>
              <dt>ÁREAS</dt><dd>
                {String(communityTopics.length).padStart(2, "0")}
              </dd>
            </div>
            <div>
              <dt>AUTORES</dt><dd>{String(authors.length).padStart(2, "0")}</dd>
            </div>
          </dl>
        </aside>
      </section>

      <div class="ticker" aria-hidden="true">
        <div>
          <span>ENGENHARIA DE SOFTWARE</span><b>◆</b><span>DADOS &amp; IA</span
          ><b>◆</b><span>DEVOPS &amp; CLOUD</span><b>◆</b><span
            >OPEN SOURCE</span
          ><b>◆</b><span>COMUNIDADE</span>
        </div>
      </div>

      {
        featured && (
          <section class="section shell" aria-labelledby="destaque-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">ARQUIVO // DESTAQUE EDITORIAL</p>
                <h2 id="destaque-title">Sinal em evidência</h2>
              </div>
              <span class="registry">
                REG-{featured.data.publishedAt.getFullYear()}-
                {String(posts.indexOf(featured) + 1).padStart(3, "0")}
              </span>
            </div>

            <article class="featured-record">
              <div class="featured-image">
                <Image
                  src={featured.data.cover}
                  alt={featured.data.coverAlt}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 800px) calc(100vw - 2rem), 55vw"
                  format={featured.data.cover.format === "svg" ? "svg" : "webp"}
                />
                <span class="stamp">EM DESTAQUE</span>
              </div>
              <div class="featured-copy">
                <div class="record-meta">
                  <span>
                    {categoryName(featured.data.categories[0] as CategoryId)}
                  </span>
                  <time datetime={featured.data.publishedAt.toISOString()}>
                    {formatDate(featured.data.publishedAt)}
                  </time>
                </div>
                <h3>{featured.data.title}</h3>
                <p>{featured.data.description}</p>
                <p class="byline">
                  POR{" "}
                  <strong>
                    {authorsById.get(featured.data.author.id)?.name ??
                      "TECHS COMMUNITY"}
                  </strong>
                </p>
                <a class="text-link" href={routes.article(featured.id)}>
                  Ler artigo <span>→</span>
                </a>
              </div>
            </article>
          </section>
        )
      }

      <section
        class="section shell"
        id="recentes"
        aria-labelledby="recentes-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">ÚLTIMAS TRANSMISSÕES</p>
            <h2 id="recentes-title">Registros recentes</h2>
          </div>
          <span class="registry">ORDENADO // MAIS RECENTES</span>
        </div>

        {
          recentPosts.length > 0 ? (
            <div class="records-grid">
              {recentPosts.map((post, index) => (
                <article class="record-card" id={`registro-${post.id}`}>
                  <div class="card-image">
                    <Image
                      src={post.data.cover}
                      alt={post.data.coverAlt}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 800px) calc(100vw - 2rem), 36vw"
                      format={post.data.cover.format === "svg" ? "svg" : "webp"}
                      loading="lazy"
                    />
                    <span class="record-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <div class="card-body">
                    <div class="record-meta">
                      <span>
                        {categoryName(post.data.categories[0] as CategoryId)}
                      </span>
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {formatDate(post.data.publishedAt)}
                      </time>
                    </div>
                    {post.data.draft && (
                      <span class="draft-label">RASCUNHO // PREVIEW</span>
                    )}
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <p class="byline">
                      POR{" "}
                      <strong>
                        {authorsById.get(post.data.author.id)?.name ??
                          "TECHS COMMUNITY"}
                      </strong>
                    </p>
                    <a class="text-link" href={routes.article(post.id)}>
                      Ler artigo <span>→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">Nenhum registro recente disponível.</p>
          )
        }
      </section>

      <section
        class="categories"
        id="assuntos"
        aria-labelledby="assuntos-title"
      >
        <div class="shell categories-inner">
          <div>
            <p class="eyebrow">SOBRE O QUE A GENTE FALA</p>
            <h2 id="assuntos-title">Escolha sua frequência.</h2>
            <p>
              As conversas acontecem em grupos por tema. Você acompanha os
              assuntos que quiser e entra no seu ritmo.
            </p>
          </div>
          <ul>
            {
              communityTopics.map(([name, description], index) => (
                <li class="topic-row">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <strong>{name}</strong>
                    <small>{description}</small>
                  </div>
                  <i aria-hidden="true">◆</i>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section
        class="join shell"
        id="participar"
        aria-labelledby="participar-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">PROTOCOLO DE ENTRADA // WHATSAPP</p>
            <h2 id="participar-title">Como participar</h2>
          </div>
          <span class="registry">ACESSO // VIA GITHUB</span>
        </div>
        <ol class="join-steps">
          <li>
            <span>01</span><strong>Abra uma issue</strong>
            <p>Solicite seu acesso no GitHub da comunidade.</p>
          </li>
          <li>
            <span>02</span><strong>Aguarde a validação</strong>
            <p>A equipe confere o pedido e envia o convite.</p>
          </li>
          <li>
            <span>03</span><strong>Entre no WhatsApp</strong>
            <p>Escolha os grupos e assuntos que mais interessam.</p>
          </li>
          <li>
            <span>04</span><strong>Compartilhe</strong>
            <p>Conhecimento, vagas, ideias e uns memes também.</p>
          </li>
        </ol>
        <div class="join-action">
          <p>
            Ao entrar, respeite as pessoas participantes e o Código de Conduta.
          </p>
          <a
            class="button button-primary"
            href={joinUrl}
            target="_blank"
            rel="noreferrer">Solicitar acesso ↗</a
          >
        </div>
      </section>

      <section
        class="manifesto shell"
        id="manifesto"
        aria-labelledby="manifesto-title"
      >
        <p class="eyebrow">PROTOCOLO DE COMUNIDADE // 001</p>
        <h2 id="manifesto-title">
          Ninguém sabe tudo.<br /><em>Todo mundo sabe algo.</em>
        </h2>
        <p>
          A Techs Community existe para transformar experiência individual em
          conhecimento coletivo. Arquitetura, sistemas, desenvolvimento,
          segurança, carreira ou aquele assunto inesperado: aqui, compartilhar é
          infraestrutura.
        </p>
        <a
          class="button button-primary"
          href={joinUrl}
          target="_blank"
          rel="noreferrer">Abrir solicitação no GitHub ↗</a
        >
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <div class="wordmark footer-wordmark">
          <span class="wordmark-mark" aria-hidden="true">TC</span><span
            >TECHS<br />COMMUNITY</span
          >
        </div>
        <p>Feito por pessoas de tecnologia, para pessoas de tecnologia. 💛</p>
        <p class="footer-code">
          © {new Date().getFullYear()} // SINAL PERMANECE ABERTO
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    min-width: 320px;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-border) 7%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-border) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 80px 80px;
  }

  .shell {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
  }
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-focus);
    color: white;
    transform: translateY(-180%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
  }
  .header-inner {
    min-height: 5.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font: 800 0.78rem/0.92 var(--font-display);
    letter-spacing: 0.11em;
  }
  .wordmark-mark {
    display: grid;
    place-items: center;
    width: 2.35rem;
    aspect-ratio: 1;
    border: 2px solid var(--color-text);
    color: var(--color-brand);
    font: 900 0.75rem/1 var(--font-mono);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    font: 600 0.74rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  nav a {
    padding-block: 1rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .hero {
    min-height: calc(100vh - 5.25rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }
  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--color-muted);
    font: 600 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow span {
    color: var(--color-brand);
  }
  .hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 5.25vw, 5.4rem);
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 0.88;
    text-transform: uppercase;
  }
  h1 em,
  h2 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .hero-lead {
    max-width: 37rem;
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--color-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
  .button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .button-primary {
    background: var(--color-brand);
    color: var(--color-brand-contrast);
    border-color: var(--color-brand);
  }
  .button-primary:hover {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .button-ghost:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .signal-panel {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 12px 12px 0
      color-mix(in srgb, var(--color-border) 25%, transparent);
  }
  .signal-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .live {
    color: var(--color-brand);
  }
  .live i {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: var(--color-brand);
  }
  .signal-visual {
    padding: 5%;
    background: var(--color-bg);
  }
  .signal-visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .signal-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .signal-stats div {
    padding: 1rem;
    border-right: 1px solid var(--color-border);
  }
  .signal-stats div:last-child {
    border: 0;
  }
  .signal-stats dt {
    color: var(--color-muted);
    font: 600 0.58rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .signal-stats dd {
    margin: 0.5rem 0 0;
    font: 800 1.6rem/1 var(--font-display);
  }

  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--color-border);
    background: var(--color-text);
    color: var(--color-bg);
  }
  .ticker div {
    width: max-content;
    display: flex;
    gap: 2.3rem;
    padding: 0.85rem 1.2rem;
    font: 700 0.68rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .ticker b {
    color: var(--color-brand);
  }
  .section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 2px solid var(--color-border);
  }
  .section-heading h2,
  .categories h2,
  .manifesto h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.8rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .section-heading .eyebrow {
    margin-bottom: 0.6rem;
  }
  .registry {
    color: var(--color-muted);
    font: 600 0.62rem/1.4 var(--font-mono);
    text-align: right;
  }

  .featured-record {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .featured-image {
    position: relative;
    min-height: 25rem;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-bg);
  }
  .featured-image :global(img),
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  .stamp {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5rem 0.7rem;
    background: var(--color-brand);
    color: var(--color-brand-contrast);
    font: 800 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .record-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-brand);
    font: 700 0.62rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .record-meta time {
    color: var(--color-muted);
  }
  .featured-copy h3,
  .card-body h3 {
    margin: 1.2rem 0 0;
    font-size: clamp(1.8rem, 3.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
  }
  .featured-copy > p:not(.byline),
  .card-body > p:not(.byline) {
    color: var(--color-muted);
  }
  .byline {
    margin-top: auto;
    padding-top: 1.2rem;
    font: 600 0.65rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
  }
  .text-link {
    width: fit-content;
    margin-top: 1rem;
    color: var(--color-brand);
    font: 800 0.72rem/1 var(--font-mono);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35rem;
    text-transform: uppercase;
  }

  .records-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .record-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .record-number {
    position: absolute;
    right: 0;
    bottom: 0;
    min-width: 2.6rem;
    padding: 0.45rem;
    background: var(--color-text);
    color: var(--color-bg);
    font: 700 0.7rem/1 var(--font-mono);
    text-align: center;
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }
  .card-body h3 {
    font-size: clamp(1.55rem, 2.5vw, 2.25rem);
  }
  .card-body > p:not(.byline) {
    font-size: 0.92rem;
  }
  .draft-label {
